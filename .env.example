# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/karc?sslmode=verify-full

# ── Discord Bot ───────────────────────────────────────────────
BOT_TOKEN=your-bot-token-here
CLIENT_ID=your-client-id-here

# Test guild for npm run deploy:dev
GUILD_ID=your-test-guild-id-here

# ── Bot Presence ──────────────────────────────────────────────
BOT_STATUS=online
BOT_ACTIVITY_TYPE=WATCHING
BOT_ACTIVITY_TEXT=over things

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development
