generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Add models below ──────────────────────────────────────────────────────────

model Group {
  id            String            @id @default(cuid())
  codeName      String            @unique
  name          String
  ownerId       String
  guildId       String
  discordRoleId String?
  roles         GroupRole[]
  members       GroupRoleMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model GroupRole {
  id                   String                 @id @default(cuid())
  groupId              String
  group                Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  discordRoleId        String?
  color                String?
  name                 String
  subName              String?
  position             Int
  canManageAssignments Boolean                @default(false)
  canManageGroup       Boolean                @default(false)
  members              GroupRoleMember[]
  progressionsFrom     GroupRoleProgression[] @relation("ProgressionFrom")
  progressionsTo       GroupRoleProgression[] @relation("ProgressionTo")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([groupId, name])
}

model GroupRoleProgression {
  fromRoleId String
  fromRole   GroupRole @relation("ProgressionFrom", fields: [fromRoleId], references: [id], onDelete: Cascade)
  toRoleId   String
  toRole     GroupRole @relation("ProgressionTo",   fields: [toRoleId],   references: [id], onDelete: Cascade)

  @@id([fromRoleId, toRoleId])
}

model Character {
  id          String            @id @default(cuid())
  guildId     String
  userId      String
  name        String
  bio         String?
  residenceId String?
  residence   Residence?        @relation(fields: [residenceId], references: [id], onDelete: SetNull)
  careerId    String?
  career      Career?           @relation(fields: [careerId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupRoleMember[]

  @@unique([guildId, userId, name])
}

model Residence {
  id         String          @id @default(cuid())
  value      String          @unique
  characters Character[]
  roles      ResidenceRole[]
}

model ResidenceRole {
  id            String    @id @default(cuid())
  guildId       String
  residenceId   String
  residence     Residence @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  discordRoleId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, residenceId])
}

model Career {
  id         String       @id @default(cuid())
  value      String       @unique
  characters Character[]
  roles      CareerRole[]
}

model CareerRole {
  id            String   @id @default(cuid())
  guildId       String
  careerId      String
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  discordRoleId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([guildId, careerId])
}

model GroupRoleMember {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupRoleId String
  groupRole   GroupRole @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  assignedAt  DateTime  @default(now())

  @@unique([groupId, characterId])
}
